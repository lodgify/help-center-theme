<div class="hc-container hc-band-wrap">
  <section class="hc-band hc-band--stack">
    <nav aria-label="Breadcrumb">
      {{breadcrumbs}}
    </nav>
    <h1 class="hc-display hc-display--xl">{{section.name}}</h1>
    {{#if section.description}}<p class="hc-band__lead">{{section.description}}</p>{{/if}}
  </section>
</div>

<main class="hc-layout hc-container">
  <nav class="hc-sidenav hc-desk-only" aria-label="Sections" data-sections-nav data-current-section="{{section.id}}">
    <h2 class="hc-eyebrow" data-sections-title>Sections</h2>
    <ul class="hc-sidenav__list" data-sections-list></ul>
  </nav>

  <div class="hc-layout__main" data-section-articles data-section-id="{{section.id}}">
    {{#if section.sections}}
    <div class="hc-subsections">
      <div class="hc-layout__head">
        <h2 class="hc-h2">Sections</h2>
      </div>
      <div class="hc-section-grid">
        {{#each section.sections}}
        <article class="hc-section-card">
          <div class="hc-section-card__head">
            <h3><a href="{{url}}">{{name}}</a></h3>
            <span class="hc-tag" data-count="{{article_count}}">{{article_count}} articles</span>
          </div>
          {{#if articles}}
          <ul class="hc-section-card__list">
            {{#each articles}}
            <li>
              <a href="{{url}}"><span>{{title}}</span><svg class="hc-icon hc-icon--sm" aria-hidden="true"><use href="#icon-angle-right"/></svg></a>
            </li>
            {{/each}}
          </ul>
          {{/if}}
          <a class="hc-more" href="{{url}}">See all {{article_count}} articles
            <svg class="hc-icon hc-icon--sm" aria-hidden="true"><use href="#icon-arrow-right"/></svg>
          </a>
        </article>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if section.articles}}
    <div class="hc-layout__head">
      <h2 class="hc-h2">Articles</h2>
    </div>
    <ul class="hc-article-list">
      {{#each section.articles}}
      <li>
        <a class="hc-article-row" href="{{url}}" data-article-id="{{id}}">
          <span class="hc-article-row__icon"><svg class="hc-icon" aria-hidden="true"><use href="#icon-file"/></svg></span>
          <span class="hc-article-row__body">
            <span class="hc-article-row__title">
              <span class="hc-article-row__name" data-title>{{title}}</span>
              {{#if promoted}}<span class="hc-tag hc-tag--accent">Featured</span>{{/if}}
            </span>
            <span class="hc-article-row__excerpt" data-excerpt></span>
          </span>
          <span class="hc-article-row__date" data-updated></span>
        </a>
      </li>
      {{/each}}
    </ul>
    {{pagination}}
    {{else}}
    {{#unless section.sections}}
    <p class="hc-empty">No articles in this section yet.</p>
    {{/unless}}
    {{/if}}
  </div>
</main>
