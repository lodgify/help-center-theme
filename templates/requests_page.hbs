<main class="hc-container hc-confirm" id="main-content">
  <span class="hc-confirm__icon" aria-hidden="true"><svg class="hc-icon hc-icon--xl"><use href="#icon-envelope-send"/></svg></span>
  <h1 class="hc-display hc-display--xl">We reply to requests by email</h1>
  <p class="hc-band__lead">You'll find our replies in your inbox. If you need help with something else, see how to contact us.</p>
  <div class="hc-confirm__actions">
    <a class="hc-btn hc-btn--primary" href="{{settings.contact_url}}">Contact us</a>
    <a class="hc-btn hc-btn--ghost" href="{{page_path 'help_center'}}">Back to the Help Center</a>
  </div>
</main>
