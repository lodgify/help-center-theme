<header class="hc-header" id="hc-header">
  <div class="hc-header__row hc-container">
    <a class="hc-capsule hc-brand" href="{{page_path 'help_center'}}" aria-label="Lodgify Help Center home">
      <svg class="hc-brand__logo" viewBox="0 0 76.113 20" width="84" height="22" role="img" aria-label="Lodgify"><use href="#logo-word"/></svg>
      <span class="hc-brand__divider" aria-hidden="true"></span>
      <span class="hc-brand__name">Help Center</span>
    </a>

    <nav class="hc-capsule hc-nav hc-desk" aria-label="Main">
      <a class="hc-nav__link" href="{{page_path 'help_center'}}#topics">Knowledge base</a>
      {{#if settings.use_cases_url}}<a class="hc-nav__link" href="{{settings.use_cases_url}}">Use cases</a>{{/if}}
    </nav>

    <div class="hc-capsule hc-actions hc-desk">
      {{#if alternative_locales}}
      <details class="hc-lang">
        <summary class="hc-nav__link" aria-label="Change language">
          <svg class="hc-icon hc-icon--sm" aria-hidden="true"><use href="#icon-globe"/></svg>
          <span>{{current_locale.name}}</span>
          <svg class="hc-icon hc-icon--sm" aria-hidden="true"><use href="#icon-angle-down"/></svg>
        </summary>
        <ul class="hc-lang__menu">
          {{#each alternative_locales}}
          <li><a href="{{url}}" dir="{{direction}}" rel="nofollow">{{name}}</a></li>
          {{/each}}
        </ul>
      </details>
      {{/if}}
      <a class="hc-btn hc-btn--accent hc-btn--sm" href="{{settings.contact_url}}">Contact us</a>
    </div>

    <div class="hc-capsule hc-mobile-actions hc-mob">
      <a class="hc-icon-btn" href="{{page_path 'help_center'}}#hc-menu-search" data-open-menu="search" aria-label="Search the Help Center">
        <svg class="hc-icon" aria-hidden="true"><use href="#icon-search"/></svg>
      </a>
      <button class="hc-icon-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="hc-menu" data-open-menu>
        <svg class="hc-icon" aria-hidden="true"><use href="#icon-bars"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="hc-menu" id="hc-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="hc-menu__panel">
    <div class="hc-menu__top">
      <a class="hc-menu__brand" href="{{page_path 'help_center'}}" aria-label="Lodgify Help Center home">
        <svg viewBox="0 0 76.113 20" width="76" height="20" role="img" aria-label="Lodgify"><use href="#logo-word"/></svg>
        <span class="hc-brand__divider" aria-hidden="true"></span>
        <span class="hc-brand__name">Help Center</span>
      </a>
      <button class="hc-icon-btn hc-icon-btn--onDark" type="button" aria-label="Close menu" data-close-menu>
        <svg class="hc-icon" aria-hidden="true"><use href="#icon-close"/></svg>
      </button>
    </div>

    <div class="hc-menu__search">
      {{search class='hc-search hc-search--menu' placeholder='Search articles'}}
    </div>

    <nav class="hc-menu__nav" aria-label="Main">
      <a href="{{page_path 'help_center'}}#topics" data-close-menu>Knowledge base <svg class="hc-icon" aria-hidden="true"><use href="#icon-arrow-right"/></svg></a>
      {{#if settings.use_cases_url}}<a href="{{settings.use_cases_url}}">Use cases <svg class="hc-icon" aria-hidden="true"><use href="#icon-arrow-right"/></svg></a>{{/if}}
    </nav>

    <div class="hc-menu__bottom">
      <div class="hc-menu__row">
        {{#if alternative_locales}}
        <details class="hc-lang hc-lang--menu">
          <summary aria-label="Change language">
            <svg class="hc-icon hc-icon--sm" aria-hidden="true"><use href="#icon-globe"/></svg>
            <span>{{current_locale.name}}</span>
            <svg class="hc-icon hc-icon--sm" aria-hidden="true"><use href="#icon-angle-down"/></svg>
          </summary>
          <ul class="hc-lang__menu">
            {{#each alternative_locales}}
            <li><a href="{{url}}" dir="{{direction}}" rel="nofollow">{{name}}</a></li>
            {{/each}}
          </ul>
        </details>
        {{/if}}
      </div>
      <a class="hc-btn hc-btn--accent hc-btn--lg hc-btn--block" href="{{settings.contact_url}}">Contact us</a>
    </div>
  </div>
</div>

