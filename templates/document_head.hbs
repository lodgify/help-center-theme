<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" sizes="32x32" href="{{asset 'lodgify-favicon.png'}}">
<script>
  /* Keep only the Lodgify favicon: remove the default one Zendesk adds. */
  (function () {
    var ours = document.querySelector('link[rel="icon"][href*="theming_assets"]');
    if (!ours) return;
    Array.prototype.forEach.call(document.querySelectorAll('link[rel~="icon"]'), function (l) {
      if (l !== ours) l.parentNode.removeChild(l);
    });
  })();
</script>
