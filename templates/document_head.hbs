<script>
  /* The request form only opens from a link with the sign-in help form ID,
     for example /hc/en-us/requests/new?ticket_form_id=FORM_ID.
     Any other visit to /requests/new goes to the Contact us link. */
  (function () {
    var formId = '{{settings.signin_form_id}}';
    var contactUrl = '{{settings.contact_url}}';
    if (!formId || !contactUrl) return;
    if (!/^\/hc\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?requests\/new\/?$/i.test(window.location.pathname)) return;
    var params = new URLSearchParams(window.location.search);
    if (params.get('ticket_form_id') !== formId) window.location.replace(contactUrl);
  })();
</script>
